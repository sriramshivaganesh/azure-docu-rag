# Copy this file to ".env" in the backend folder and fill in the values.
# See the README (section 2) for where to find each one in the Azure portal.

# Azure OpenAI (Azure AI Foundry) -> resource "Keys and Endpoint"
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# the DEPLOYMENT NAMES you chose (not the model names, unless you kept them the same)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini-1
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure AI Search -> Overview (Url) and Settings > Keys (Admin key)
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=rag-docs

# Storage account -> Security + networking > Access keys > Connection string
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=documents
